# Copy to $STACK_HOME/stack.env (default ~/AI/stack.env). scripts/env.sh sources it,
# which is how the launchd supervisor sees values your shell profile would otherwise set.

# Required: the downloaded mtplx model snapshot
MTPLX_MODEL="$HOME/.cache/huggingface/hub/models--Youssofal--Qwen3.8-27B-MTPLX-Optimized-Speed/snapshots/REVISION"

# Optional overrides (defaults shown)
# STACK_LABEL=com.example.ai-stack
# BACKUP_ROOT="$HOME/Backups/ai-stack"
# LLM_PORT=8000  WEBUI_PORT=8080  MCPO_PORT=8600  KOKORO_PORT=8880  SEARXNG_PORT=8888  DOCLING_PORT=5001
# BACKUP_EXTRA="$HOME/.config/mcp-email-server"
